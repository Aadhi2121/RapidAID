# CivicAI Environment Configuration

# Database Connection (PostgreSQL or SQLite)
# PostgreSQL: postgresql://postgres:civicai_password@localhost:5432/civicai_db
# SQLite (Local Dev zero-config): sqlite:///./civicai.db
DATABASE_URL=sqlite:///./civicai.db

# Authentication Security
JWT_SECRET=civicai-super-secret-key-production-ready-2026

# AI Pipeline Mode: "real" (loads Whisper & NLP models) or "mock" (instant deterministic fallback)
AI_MODE=real

# Local ML Model Weights Storage
MODEL_PATH=./ml_models

# Optional LLM API Key (e.g. Gemini / OpenAI for custom generative tasks)
LLM_API_KEY=
